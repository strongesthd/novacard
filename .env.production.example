# Copy to /home/app/novacard/.env on VPS. Never commit the real file.
POSTGRES_PASSWORD=<generate-a-long-random-secret>
REDIS_PASSWORD=<generate-a-long-random-secret>
MINIO_ROOT_PASSWORD=<generate-a-long-random-secret>

# OAuth: tao app tren Google Cloud Console va Meta for Developers.
# Callback URLs:
# https://novacard.novatechhp.vn/api/auth/google/callback
# https://novacard.novatechhp.vn/api/auth/facebook/callback
PUBLIC_APP_URL=https://novacard.novatechhp.vn
API_PUBLIC_URL=https://novacard.novatechhp.vn/api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
